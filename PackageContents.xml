        <ComponentEntry
            AppName="qjs_2017"
            ModuleName="./Contents/2017/qjs_2017.arx"
            AppType=".arx"
            LoadOnAutoCADStartup="True">
            <Commands GroupName="ARX01_COMMANDS">
