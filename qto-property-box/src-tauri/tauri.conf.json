{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QTO Property Box",
  "version": "0.1.0",
  "identifier": "com.grxscript.qtopropertybox",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QTO Property Box",
        "width": 560,
        "height": 780,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}